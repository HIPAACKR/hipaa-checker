FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Declare build-time arguments
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_API_BASE_URL_V2
ARG NEXT_PUBLIC_LLM_API_BASE_URL
ARG NEXT_PUBLIC_ENABLE_LLM_FEATURES
ARG NEXT_PUBLIC_STRIPE_PUBLIC_KEY

# Make them available as environment variables
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL_V2=$NEXT_PUBLIC_API_BASE_URL_V2
ENV NEXT_PUBLIC_LLM_API_BASE_URL=$NEXT_PUBLIC_LLM_API_BASE_URL
ENV NEXT_PUBLIC_ENABLE_LLM_FEATURES=$NEXT_PUBLIC_ENABLE_LLM_FEATURES
ENV NEXT_PUBLIC_STRIPE_PUBLIC_KEY=$NEXT_PUBLIC_STRIPE_PUBLIC_KEY

ENV PORT=5002

RUN npm run build

EXPOSE 5002

CMD ["npm", "start"]