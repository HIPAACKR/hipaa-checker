# Copy this file to .env and fill in real values before running
# `docker compose up`. A ready-to-run .env with generated local secrets
# is created automatically the first time someone sets this project up
# with an assistant/script — but if you're doing it by hand, start here.

# --- Postgres (used to build DATABASE_URL for backend/sidekiq) ---
POSTGRES_PASSWORD=change-me

# --- Rails ---
# Required. Rails uses this directly and never needs to decrypt
# config/credentials.yml.enc, so RAILS_MASTER_KEY is intentionally not used
# here (see backend/Dockerfile for why leaving it truly unset matters).
SECRET_KEY_BASE=generate-with-openssl-rand-hex-64
RAILS_LOG_TO_STDOUT=true

# --- Two-factor auth (devise-two-factor) ---
# Required, 32 bytes hex. Generate with: openssl rand -hex 32
OTP_SECRET_KEY=generate-with-openssl-rand-hex-32
OTP_2FA_ISSUER_NAME=HIPAA Checker

# --- reCAPTCHA (used on the web sign-up flow only) ---
# Defaults below are Google's public always-pass test keys, fine for local use.
GOOGLE_CAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_CAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- Stripe ---
# Optional at boot; only needed for billing features to actually work.
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_your_secret

# --- Frontend (Next.js) ---
# These become part of the frontend build, so they must point to wherever
# your browser can reach the backend (localhost, not the "backend" service name).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_BASE_URL_V2=http://localhost:3000/api/v2
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_key
NEXT_PUBLIC_ENABLE_LLM_FEATURES=false
NEXT_PUBLIC_LLM_API_BASE_URL=
