
<script>
  var stripe = Stripe('<%= ENV['STRIPE_PUBLIC_KEY'] %>');
  var elements = stripe.elements();
</script>

<div class="content">
  <div class="container">
    <div class="subscription-form">
      <%= simple_form_for :user, url: subscription_path do |f| %>
        <%= f.hidden_field :stripe_token %>
        <div class="d-flex flex-column">
          <strong style="margin: 10px 0 10px 10px">Please choose one of the subscription plans for <%= current_user.organization.name %></strong>
          <div class="d-flex flex-row">
            <% @plans.each do |plan| %>
              <div class="d-flex w-25">
              <label class="plan_wrapper">
                <div class="card card-input">
                  <div class="card-header">
                    <%= f.radio_button :plan_id, plan.id, class: 'card-input-element plan_input', plan_name: plan.name, checked: current_user&.organization&.plan_id == plan.id ? "checked" : "" %>
                    <span class="plan_name">
                      <%= plan.name.humanize %>
                    </span>
                    <% if current_user&.organization&.plan_id == plan.id %>
                      <svg style="float: right" xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="#037d50" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"></path>
                      </svg>
                    <% end  %>
                  </div>
                  <div class="card-body">
                    <div class="subscription_attributes">
                      <strong>Type: </strong> <%= plan.interval.humanize %>ly
                    </div>
                    <div class="subscription_attributes">
                      <strong>Price: </strong> <%= number_to_currency plan.price %>
                    </div>
                    <div class="subscription_attributes">
                      <strong>Max Allowed Users: </strong>
                      <% if plan.name == 'Premium' %>
                        Unlimited
                        <sup title="<%= plan.user_count %> max">
                          <svg height="14" viewBox="0 0 48 48" width="14" xmlns="http://www.w3.org/2000/svg"><path d="M0 0h48v48h-48z" fill="none"/><path d="M22 34h4v-12h-4v12zm2-30c-11.05 0-20 8.95-20 20s8.95 20 20 20 20-8.95 20-20-8.95-20-20-20zm0 36c-8.82 0-16-7.18-16-16s7.18-16 16-16 16 7.18 16 16-7.18 16-16 16zm-2-22h4v-4h-4v4z"/></svg>
                        </sup>
                      <% else %>
                        <% if plan.name == "Free" && current_user.organization&.is_individual? %>
                          <%= 1 %>
                        <% else %>
                          <%= plan.user_count %>
                        <% end %>
                      <% end %>
                    </div>
                    <div class="subscription_attributes">
                      <strong>Max Upload Quota(per user): </strong>
                      <% if plan.name == 'Premium' %>
                        Unlimited
                        <sup title="<%= plan.max_upload_quota %> max">
                          <svg height="14" viewBox="0 0 48 48" width="14" xmlns="http://www.w3.org/2000/svg"><path d="M0 0h48v48h-48z" fill="none"/><path d="M22 34h4v-12h-4v12zm2-30c-11.05 0-20 8.95-20 20s8.95 20 20 20 20-8.95 20-20-8.95-20-20-20zm0 36c-8.82 0-16-7.18-16-16s7.18-16 16-16 16 7.18 16 16-7.18 16-16 16zm-2-22h4v-4h-4v4z"/></svg>
                        </sup>
                      <% else %>
                        <%= plan.max_upload_quota %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </label>
            </div>
            <% end %>
          </div>
          <div class="d-flex ms-2 mb-2 align-items-center" id="card_wrapper" style="display: <%= current_user&.organization&.plan&.free? ? "none !important" : "flex" %>">
            <div id="new_card"></div>
            <button class="btn btn-outline-secondary" id="confirm_card_btn">Confirm Card</button>
          </div>
          <div class="col-6"></div>
          <div class="col-6 ms-2">
            <%= f.button 'submit', 'Continue', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  $(document).ready(function() {
    setTimeout(function() {
      const style = {
        base: {
          fontSize: '16px',
          color: '#32325d',
          border: '1px solid #ccc',
        },
      }
      const card = elements.create('card', { hidePostalCode: true, style: style });
      card.mount('#new_card');

      $('#confirm_card_btn').on('click', function(e) {
        e.preventDefault();
        $('#confirm_card_btn').text('Confirming...').attr('disabled', true);
        stripe.createToken(card).then(function(result) {
          $('#user_stripe_token').val(result.token.id);
          $('#confirm_card_btn').text('Card Confirmed');
          $('#confirm_card_btn').attr('disabled', true);
        }).catch(function (error) {
          $('#confirm_card_btn').text('Confirm Card').attr('disabled', false);
          alert("Please enter a valid card")
          console.log(error)
        })
      });
    }, 100);
  });
</script>
