<div class="container vw-100 mb-5">
  <div class="d-flex justify-content-end">
    <% if user_signed_in? %>
      <%= link_to "Sign out", destroy_user_session_path, method: :delete, class: 'btn btn-sm btn-danger m-2' %>
    <% else %>
      <%= link_to "Sign in", new_user_session_path, class: 'btn btn-sm btn-primary m-2', :onclick => "document.getElementById('id01').style.display='block'" %>
      <%= link_to "Sign Up", new_user_registration_path, class: 'btn btn-sm btn-success m-2' %>
    <% end %>
  </div>
</div>
