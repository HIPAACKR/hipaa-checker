<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold mb-4">HIPAA Vulnerability Suggestions</h1>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <h2 class="text-xl font-semibold mb-4">Create New Suggestion</h2>

    <%= form_with(model: @suggestion, local: true, class: "space-y-4") do |form| %>
      <% if @suggestion.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
          <strong class="font-bold">Oops! There were some errors:</strong>
          <ul class="mt-2 list-disc list-inside">
            <% @suggestion.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :rule_id, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.text_field :rule_id, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>

        <div>
          <%= form.label :subrule_id, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.text_field :subrule_id, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>
      </div>

      <div>
        <%= form.label :expectations_from_hipaa, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <%= form.text_area :expectations_from_hipaa, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline h-24" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :severity, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.select :severity, ['Low', 'Medium', 'High'], { prompt: 'Select Severity' },
                          class: "shadow border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>

        <div>
          <%= form.label :vulnerability_category, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.text_field :vulnerability_category, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>
      </div>

      <div>
        <%= form.label :code_snippet, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <%= form.text_area :code_snippet, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline h-24" %>
      </div>
      <div>
        <%= form.label :resources, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <%= form.text_area :resources, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline h-24" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :priority, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.number_field :priority, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>

        <div>
          <%= form.label :language, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.select :language, ['Python', 'Java', 'Ruby', 'JavaScript'], { prompt: 'Select Language' },
                          class: "shadow border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>
      </div>

      <div>
        <%= form.label :comment, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <%= form.text_area :comment, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline h-24" %>
      </div>

      <div class="flex items-center justify-between">
        <%= form.submit 'Save Suggestion', class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white shadow-md rounded px-8 pt-6 pb-8">
    <h2 class="text-xl font-semibold mb-4">Existing Suggestions</h2>

    <% if @suggestions.any? %>
      <table class="min-w-full bg-white">
        <thead>
        <tr>
          <th class="py-2 px-4 border-b">Rule ID</th>
          <th class="py-2 px-4 border-b">Severity</th>
          <th class="py-2 px-4 border-b">Language</th>
          <th class="py-2 px-4 border-b">Priority</th>
          <th class="py-2 px-4 border-b">Actions</th>
        </tr>
        </thead>
        <tbody>
        <% @suggestions.each do |suggestion| %>
          <tr>
            <td class="py-2 px-4 border-b"><%= suggestion.rule_id %></td>
            <td class="py-2 px-4 border-b"><%= suggestion.severity %></td>
            <td class="py-2 px-4 border-b"><%= suggestion.language %></td>
            <td class="py-2 px-4 border-b"><%= suggestion.priority %></td>
            <td class="py-2 px-4 border-b">
              <%= link_to 'View', suggestion_path(suggestion), class: "text-blue-600 hover:text-blue-900" %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-600">No suggestions have been created yet.</p>
    <% end %>
  </div>
</div>