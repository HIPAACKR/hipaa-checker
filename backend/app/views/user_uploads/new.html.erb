<div class="container mt-5">
  <h3 class="text-center">New Upload</h3>
  <%= form_for @user_upload do |form| %>
    <div class="row mt-4">
      <div class="col-md-3"></div>
      <div class="col-md-6 mb-2">
        <%= form.file_field :file, class: 'form-control', required: true, accept: ".zip, .apk" %>
        <span><i>Supported file formats are .zip and .apk</i></span>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-md-3" style="text-align: right; font-weight: bold">Type</div>
      <div class="col-md-6 mb-2">
        <%= form.select :upload_type, UserUpload::UPLOAD_TYPES.collect{|type| [type, type]}, { include_blank: false }, class: 'form-control' %>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-md-3" style="text-align: right; font-weight: bold">Environment</div>
      <div class="col-md-6 mb-2">
        <%= form.select :environment, UserUpload::ENVIRONMENTS.collect{|environment| [environment, environment]}, { include_blank: false }, class: 'form-control' %>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-md-3" style="text-align: right; font-weight: bold">Platform</div>
      <div class="col-md-6 mb-2">
        <%= form.select :platform, UserUpload::PLATFORMS.collect{|platform| [platform, platform]}, { include_blank: true }, class: 'form-control' %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-3"></div>
      <div class="col-md-3">
        <%= form.submit 'Upload', class: 'btn btn-md btn-primary form-control' %>
      </div>
      <div class="col-md-3">
        <%= link_to 'Cancel', :back, class: 'btn btn-md btn-danger form-control' %>
      </div>
    </div>
  <% end %>
</div>
