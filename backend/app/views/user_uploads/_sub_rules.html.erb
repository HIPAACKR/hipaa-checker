<span class="toogle">+</span>
<ul class="hidden_sub_rules">
<% pat_type = @user_upload.pattern_path %>
  <% rule_file = YAML.load_file("#{Rails.root}/patterns/#{pat_type}/#{rule_name}.yaml") rescue []%>
  <% rule_file.each do |rule| %>
    <li style="list-style: none; padding: 4px">
                    <span>
                      <% if @user_upload.analyzed_results.with_rule(rule_name).with_description(rule["description"]).exists? %>
                          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="#037d50" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                          </svg>
                        <% else %>
                          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="#be0000" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/>
                          </svg>
                        <% end %>
                    </span>
      <span style="padding-left: 5px"><%= rule["description"] %></span>
    </li>
  <% end %>
</ul>