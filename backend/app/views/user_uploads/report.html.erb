<script>
  $(function () {
    $(".toogle").click(function () {
      if($(this).text() == '+'){
        $(this).text("-").next().fadeIn();
      }
      else{
        $(this).text("+").next().fadeOut();
      }
    })
    $("button.print").click(function () {
      window.print()
    })
  })
</script>

<style>
  .toogle {
    float: right;
    cursor: pointer;
    font-size: 32px;
  }
    .rule-title {
      font-size: 18px;
    }

  td > * {
    vertical-align : middle;
  }

  @media print {
    #mainNav, .print, .action {
      display: none;
    }

    .hidden_sub_rules {
      display: block;
    }

    .body {
      background-color: #FFFFFF;
    }

  }

</style>
