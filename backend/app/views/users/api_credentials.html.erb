<br />
<div class="row margin-top-30">
  <div class="col-md-1"></div>
  <div class="col-md-1"></div>
  <div class="col-md-7 form">
    <div class="card">
      <div class="card-header fw-bold">
        <label>API KEY</label>
        <label class="pull-right copied" style="color: green; font-size: 16px; display: none; margin-left: 15px">Copied <%= image_tag "copied.png", style: "width: 20px" %></label>
      </div>
      <div class="card-body">
        <%= form_for current_user, url: update_jwt_token_path, html: {method: :put} do |f| %>
          <code class="code"
                onclick="CopyToClipboard('jwt_token')"
          >
            <textarea readonly id='jwt_token'><%= current_user.jwt_token_valid? ? current_user.jwt_token : "" %></textarea>
          </code>
          <%= current_user.jwt_token_valid? ? "" : f.submit('Generate API KEY', class: 'btn btn-primary') %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  function CopyToClipboard(copyableElementID) {
    let copyableElement = $(`#${copyableElementID}`)
    if(copyableElement.val() > ""){
      copyableElement.select();
      document.execCommand('copy');
      $(".copied").show();
    }
  }
</script>
<style>
  #jwt_token{
    width: 100%; height: 50px; cursor: pointer;
    border: none;
    outline: none;
    background: #eee;
  }
  .code{
    background-color: #eee;border: 1px solid #999;
    display: block;padding: 2px; margin-bottom: 10px; cursor: pointer
  }
</style>